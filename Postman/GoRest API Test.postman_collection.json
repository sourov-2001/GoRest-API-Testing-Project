  "item": [
    {
      "name": "User CRUD",
      "item": [
        {
          "name": "Create a new user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var random=Math.random().toString(36).substring(2);\r",
                  "\r",
                  "// Generating random email and name.\r",
                  "var useremail=\"sourov\"+random+\"@gmail.com\";\r",
                  "var username=\"sourov \"+random;\r",
                  "\r",
                  "// Setting environment variables.\r",
                  "pm.environment.set(\"email_env\",useremail);\r",
                  "pm.environment.set(\"name_env\",username);\r",
                  "pm.environment.set(\"base_url\", \"https://gorest.co.in\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Passing id everywhere via environment variable.\r",
                  "\r",
                  "var jsonData = JSON.parse(responseBody);\r",
                  "\r",
                  "pm.environment.set(\"userid_env\", jsonData.id);\r",
                  "\r",
                  "// Id is generated after completing the request.\r",
                  "// Now total 3 environment variables are available.\r",
                  "\r",
                  "// Check that the user is created successfully.\r",
                  "pm.test(\"Status Code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "// Check that the response is JSON.\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// Check that the user ID exists.\r",
                  "pm.test(\"User ID Exists\", function () {\r",
                  "    pm.expect(jsonData.id).to.not.be.undefined;\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"name\": \"{{name_env}}\",\r\n    \"email\": \"{{email_env}}\",\r\n    \"gender\": \"female\",\r\n    \"status\": \"active\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/public/v2/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "v2",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Fetch a single user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Validate JSON fields in the response using an arrow function.\r",
                  "\r",
                  "pm.test(\"Values of JSON Fields\", () => {\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    // Compare the response data with the environment data.\r",
                  "\r",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"userid_env\")));\r",
                  "    pm.expect(jsonData.email).to.eql(pm.environment.get(\"email_env\"));\r",
                  "    pm.expect(jsonData.name).to.eql(pm.environment.get(\"name_env\"));\r",
                  "\r",
                  "});\r",
                  "\r",
                  "//At the time of creating user (POST), we are storing the data in environment variable. Then when we getting the user (GET), we are comparing this response data with the post creating environment data.\r",
                  "\r",
                  "// Check that the user is fetched successfully.\r",
                  "pm.test(\"Status Code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Check that the response is JSON.\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "packages": {},
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/v2/users/{{userid_env}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "v2",
                "users",
                "{{userid_env}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "List/ View users",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This request gets all users from the API.\r",
                  "// We check that the request works correctly.\r",
                  "\r",
                  "pm.test(\"Status Code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// The API should return data in JSON format.\r",
                  "\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// The response should contain a list of users.\r",
                  "// We also check that the list is not empty.\r",
                  "\r",
                  "pm.test(\"User List is Not Empty\", function () {\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    pm.expect(jsonData).to.be.an(\"array\");\r",
                  "    pm.expect(jsonData.length).to.be.above(0);\r",
                  "\r",
                  "});\r",
                  "\r",
                  "// This confirms that the API is returning user records."
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
