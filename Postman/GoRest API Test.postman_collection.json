              "listen": "test",
              "script": {
                "exec": [
                  "// This request updates only the required field of the user.\r",
                  "\r",
                  "pm.test(\"Values of Updated Fields\", () => {\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
