        {
          "name": "Replace a User (Full )",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "//Same as creating users (POST) as if no need to update again and again manually.\r",
                  "var random=Math.random().toString(36).substring(2);\r",
                  "\r",
                  "// Generating random email and name.\r",
                  "var useremail=\"sourov\"+random+\"@gmail.com\";\r",
                  "var username=\"sourov \"+random;\r",
                  "\r",
                  "// Setting environment variables.\r",
                  "pm.environment.set(\"email_env\",useremail);\r",
                  "pm.environment.set(\"name_env\",username);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This request replaces all user information with new values.\r",
                  "// We verify that every updated field is returned correctly.\r",
                  "// The user ID should remain the same because we are updating\r",
                  "// an existing user instead of creating a new one.\r",
                  "\r",
                  "pm.test(\"Values of Replaced Fields\", () => {\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    // Compare the latest response with the stored environment values.\r",
                  "    // These values were saved during the Create User request.\r",
                  "\r",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"userid_env\")));\r",
                  "    pm.expect(jsonData.name).to.eql(pm.environment.get(\"name_env\"));\r",
                  "    pm.expect(jsonData.email).to.eql(pm.environment.get(\"email_env\"));\r",
                  "    pm.expect(jsonData.gender).to.eql(\"male\");\r",
                  "    pm.expect(jsonData.status).to.eql(\"active\");\r",
                  "\r",
                  "});\r",
                  "\r",
                  "// Check that the PUT request is completed successfully.\r",
                  "\r",
                  "pm.test(\"Status Code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Check that the API returns the updated user data in JSON format.\r",
                  "\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// This confirms that the full user information\r",
                  "// has been replaced successfully."
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n\r\n    \"name\": \"{{name_env}}\",\r\n    \"email\": \"{{email_env}}\",\r\n    \"gender\": \"male\",\r\n    \"status\": \"active\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
