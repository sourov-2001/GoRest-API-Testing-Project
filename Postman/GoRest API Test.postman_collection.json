        {
          "name": "Verify PUT Update",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This request checks whether the PUT update has been saved successfully.\r",
                  "// We fetch the same user again and compare the latest response\r",
                  "// with the values stored in the environment.\r",
                  "\r",
                  "pm.test(\"Values of Replaced Fields\", () => {\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    // Compare the latest response with the expected user data.\r",
                  "    // The values should match the information stored during\r",
                  "    // the previous requests.\r",
                  "\r",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"userid_env\")));\r",
                  "    pm.expect(jsonData.name).to.eql(pm.environment.get(\"name_env\"));\r",
                  "    pm.expect(jsonData.email).to.eql(pm.environment.get(\"email_env\"));\r",
                  "    pm.expect(jsonData.gender).to.eql(\"male\");\r",
                  "    pm.expect(jsonData.status).to.eql(\"active\");\r",
                  "\r",
                  "});\r",
                  "\r",
                  "// Check that the GET request is completed successfully.\r",
                  "\r",
                  "pm.test(\"Status Code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// Check that the API returns the latest user data in JSON format.\r",
                  "\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// This final verification confirms that the PUT update\r",
                  "// has been permanently saved on the server."
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/v2/users/{{userid_env}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
