        {
          "name": "Verify Deleted User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This request checks whether the deleted user no longer exists.\r",
                  "\r",
                  "pm.test(\"Status Code is 404\", function () {\r",
                  "    pm.response.to.have.status(404);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// This confirms that the user was deleted successfully."
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/v2/users/{{userid_env}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "public",
                "v2",
                "users",
                "{{userid_env}}"
              ]
            }
          },
          "response": []
        }
