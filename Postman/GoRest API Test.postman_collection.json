        {
          "name": "Delete a user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Check that the DELETE request is completed successfully.\r",
                  "\r",
                  "pm.test(\"Status Code is 204\", function () {\r",
                  "    pm.response.to.have.status(204);\r",
                  "});\r",
                  "\r",
                  "// A successful DELETE request should not return any response body.\r",
                  "\r",
                  "pm.test(\"Response Body is Empty\", function () {\r",
                  "    pm.expect(pm.response.text()).to.eql(\"\");\r",
                  "});\r",
                  "\r",
                  "\r",
                  "//After completing all request successfull, environment variable will be auto delete. But when we run the request again, it will create new user and update the environment variable. It free the memory space.\r",
                  "// This request deletes the user permanently from the server.\r",
                  "// Clear the temporary environment variables.\r",
                  "\r",
                  "pm.environment.unset(\"userid_env\");\r",
                  "pm.environment.unset(\"email_env\");\r",
                  "pm.environment.unset(\"name_env\");\r",
                  "\r",
                  "// This confirms that the user has been deleted successfully."
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "packages": {},
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/public/v2/users/{{userid_env}}",
