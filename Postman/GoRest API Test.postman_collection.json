              "listen": "test",
              "script": {
                "exec": [
                  "// This request checks whether the PATCH update is saved.\r",
                  "\r",
                  "pm.test(\"Values of Updated Fields\", () => {\r",
                  "\r",
                  "    var jsonData = pm.response.json();\r",
                  "\r",
                  "    // Compare the latest user data with the expected values.\r",
                  "\r",
                  "    pm.expect(jsonData.id).to.eql(Number(pm.environment.get(\"userid_env\")));\r",
                  "    pm.expect(jsonData.status).to.eql(\"inactive\");\r",
                  "\r",
                  "});\r",
                  "\r",
                  "// Check that the request is successful.\r",
                  "\r",
                  "pm.test(\"Status Code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "// The API should return the latest user data in JSON format.\r",
                  "\r",
                  "pm.test(\"Content-Type is JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\r",
                  "});\r",
                  "\r",
                  "// This confirms that the PATCH update is permanently saved."
                ],
